{
  "name": "nexus-project",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:vps": "node scripts/build-vps.js",
    "preview": "vite preview",
    "test": "vitest run",
    "docker:build": "docker build -t pontofacil:local .",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f pontofacil",
    "docker:info": "docker version",
    "docker:compose": "docker compose version",
    "docker:ps": "docker ps",
    "docker:run": "docker run -d --name pontofacil -p 8080:80 pontofacil:local",
    "docker:stop": "docker stop pontofacil",
    "docker:rm": "docker rm -f pontofacil"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "vite": "^6.4.4",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^5.1.2"
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  }
}
